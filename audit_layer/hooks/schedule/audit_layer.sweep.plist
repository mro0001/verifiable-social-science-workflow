<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  A launchd agent template that runs the audit layer's sweep every 30 minutes.
  Before installing it, replace the two values below, as INSTALL.md says.
  PYTHON_PATH is the full path of the python3 that runs the audit layer.
  REPO_PATH is the full path of the repository folder that holds audit_layer.
  Nothing in the repository installs this file.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>audit_layer.sweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>PYTHON_PATH</string>
    <string>-m</string>
    <string>audit_layer</string>
    <string>sweep</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPO_PATH</string>
  <key>StartInterval</key>
  <integer>1800</integer>
</dict>
</plist>
